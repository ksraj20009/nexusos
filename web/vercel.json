{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/apt-repo/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/apt-repo/dists/(.*)/InRelease",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" }
      ]
    },
    {
      "source": "/apt-repo/dists/(.*)/Release",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" }
      ]
    },
    {
      "source": "/apt-repo/dists/(.*)/Packages",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" }
      ]
    },
    {
      "source": "/apt-repo/dists/(.*)/Packages.gz",
      "headers": [
        { "key": "Content-Type", "value": "application/gzip" }
      ]
    }
  ]
}
