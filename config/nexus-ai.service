[Unit]
Description=NexusOS AI Assistant Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raj
Group=raj
ExecStart=/usr/bin/python3 /opt/nexusos/ai/nexus-ai.py --service
WorkingDirectory=/opt/nexusos/ai
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/raj
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/log /home/raj/.config/nexusos
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target