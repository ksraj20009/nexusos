# NexusOS Calamares Branding
# ===========================
# Branding for the Calamares installer

componentName: nexusos

strings:
  productName: "NexusOS"
  shortProductName: "NexusOS"
  version: "1.0"
  shortVersion: "1.0"
  codename: "Aurora"
  productUrl: "https://github.com/ksraj20009/nexusos"
  supportUrl: "https://github.com/ksraj20009/nexusos/issues"
  knownIssuesUrl: "https://github.com/ksraj20009/nexusos/issues"

images:
  productLogo: "nexusos-logo.png"
  productIcon: "nexusos-icon.png"
  productWelcome: "welcome.png"

slideshow: "show.qml"

style:
  sidebarBackground: "#0a0e1a"
  sidebarText: "#8892a6"
  sidebarTextSelect: "#00d4ff"
  sidebarBackgroundSelected: "#131826"
  
  windowBackground: "#0a0e1a"
  windowText: "#e8ecf1"
  
  selectionColor: "#00d4ff"
  
  # Welcome screen
  welcomeBackground: "#0a0e1a"