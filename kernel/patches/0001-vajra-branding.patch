# Vajra OS Kernel Branding Patch
# Changes the kernel version string to show "Vajra OS"
# Applied to: init/version.c

diff --git a/init/version.c b/init/version.c
index 2ee22354069a..1a2b3c4d5e6f 100644
--- a/init/version.c
+++ b/init/version.c
@@ -45,6 +45,11 @@
 
 const char linux_proc_banner[] =
 	"%s version %s"
+	" (Vajra OS 1.0)"
 	" (gcc version %d.%d.%d) %s"
 	" #1 SMP " UTS_VERSION "\n";
 
+/* Vajra OS branding — वज्र */
+const char vajra_os_version[] = "Vajra OS 1.0";
+const char vajra_os_codename[] = "Vajra";
+EXPORT_SYMBOL_GPL(vajra_os_version);
+EXPORT_SYMBOL_GPL(vajra_os_codename);
