[Unit]
Description=NexusOS AI Assistant
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=nexus
ExecStart=/usr/bin/python3 /opt/nexusos/ai/nexus-ai.py --service
Restart=always
RestartSec=5
Environment=HOME=/home/nexus
Environment=DISPLAY=:0
[Install]
WantedBy=multi-user.target
