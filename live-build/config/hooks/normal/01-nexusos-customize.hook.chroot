#!/bin/bash
set -e
echo "NexusOS Chroot Customization"
mkdir -p /opt/nexusos/{ai,privacy,desktop,scripts,config} /etc/nexusos
chmod +x /opt/nexusos/ai/*.py 2>/dev/null || true
chmod +x /opt/nexusos/scripts/*.sh 2>/dev/null || true
cat > /usr/bin/nexus-ai << 'EOF'
#!/bin/bash
exec python3 /opt/nexusos/ai/nexus-ai.py "$@"
EOF
chmod +x /usr/bin/nexus-ai
echo "nexusos" > /etc/hostname
useradd -m -s /bin/bash -G sudo,netdev,plugdev,audio,video,cdrom nexus 2>/dev/null || true
echo "nexus:nexus" | chpasswd
echo "root:nexus" | chpasswd
mkdir -p /etc/gdm3
cat > /etc/gdm3/daemon.conf << 'EOF'
[daemon]
WaylandEnable=true
AutomaticLoginEnable=true
AutomaticLogin=nexus
[security]
DisallowRoot=true
EOF
echo "nexus ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/nexus
chmod 440 /etc/sudoers.d/nexus
cat > /etc/systemd/system/nexus-ai.service << 'EOF'
[Unit]
Description=NexusOS AI Assistant
After=network-online.target
[Service]
Type=simple
User=nexus
ExecStart=/usr/bin/python3 /opt/nexusos/ai/nexus-ai.py --service
Restart=always
[Install]
WantedBy=multi-user.target
EOF
cat > /etc/systemd/system/nexus-tor.service << 'EOF'
[Unit]
Description=NexusOS Tor Proxy
After=tor.service
[Service]
Type=oneshot
ExecStart=/opt/nexusos/privacy/setup-tor-proxy.sh
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
EOF
systemctl enable nexus-ai nexus-tor tor firewalld 2>/dev/null || true
systemctl disable avahi-daemon cups bluetooth 2>/dev/null || true
mkdir -p /home/nexus/.config
chown -R nexus:nexus /home/nexus
cat > /etc/motd << 'EOF'
   NexusOS 1.0 Aurora
   Your OS. Your Rules. Your Privacy.
   Press Ctrl+Space for AI command bar.
EOF
echo "NexusOS customization done!"
