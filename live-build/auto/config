#!/bin/bash
# ============================================================================
# Vajra OS (वज्र OS) — live-build configuration
# ============================================================================
# This script configures live-build to create a bootable Vajra OS ISO.
# It defines the base distribution, packages, desktop, and branding.
#
# Usage: cd live-build && lb config
# ============================================================================
set -e

# --- Base distribution ---
# Built on Debian Trixie (testing) for modern packages
lb config \
    --distribution trixie \
    --architecture amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --debian-installer live \
    --debian-installer-gui true \
    --iso-volume "Vajra OS 1.0" \
    --iso-publisher "Vajra OS Project; https://vajra-os.org; packages@vajra-os.org" \
    --iso-application "Vajra OS (वज्र OS) — India's Privacy-First AI-Powered Operating System" \
    --bootappend-live "boot=live components locales=en_IN.UTF-8 keyboard-layouts=us username=vajra user-fullname=Vajra hostname=vajra-os timezone=Asia/Kolkata" \
    --security true \
    --updates true

echo "[Vajra OS] live-build configuration complete."
echo "[Vajra OS] Run: sudo lb build"
